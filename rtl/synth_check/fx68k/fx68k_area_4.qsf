set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY fx68k_area_top4
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SEED 1
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SYSTEMVERILOG_FILE ../../cpu/fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../cpu/fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../cpu/fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE fx68k_area_top.sv
set_global_assignment -name SDC_FILE fx68k_area.sdc
# Virtual pins: the pad ring must not enter the measurement.
set_instance_assignment -name VIRTUAL_PIN ON -to clk
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to sig[*]
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
